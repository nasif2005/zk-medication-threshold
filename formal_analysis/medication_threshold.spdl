/* Efficient symbolic model.
 * P = patient prover, D = dispenser, A = MEA.
 * Proof is an ideal opaque zk-SNARK token. Its cryptographic correctness is
 * assumed; Scyther analyzes secrecy, authentication, and replay resistance. */

/* Deployment assumption: P, D, and A are distinct principals. */
option "--one-role-per-agent";

const pk: Function;
secret sk: Function;
inversekeys(pk,sk);

protocol MedicationThreshold(P,D,A)
{
  role D
  {
    fresh Nd,Request: Nonce;
    var Np,Decision: Nonce;
    var Proof: Ticket;

    send_1(D,P,
      D,P,A,Nd,Request,
      {D,P,A,Nd,Request}sk(D));

    recv_3(A,D,
      A,D,P,Nd,Np,Request,Proof,Decision,
      {P,A,D,Nd,Np,Request,Proof}sk(P),
      {A,D,P,Nd,Np,Request,Proof,Decision}sk(A));

    claim(D,Alive);
    claim(D,Weakagree);
    claim(D,Niagree);
    claim(D,Nisynch);

    send_4(D,A,
      D,A,P,Nd,Np,Request,Proof,Decision,
      {D,A,P,Nd,Np,Request,Proof,Decision}sk(D));
  }

  role P
  {
    var Nd,Request,Decision: Nonce;
    fresh Np,History,StateRand: Nonce;
    fresh Proof: Ticket;

    recv_1(D,P,
      D,P,A,Nd,Request,
      {D,P,A,Nd,Request}sk(D));

    send_2(P,A,
      P,A,D,Nd,Np,Request,Proof,
      {D,P,A,Nd,Request}sk(D),
      {P,A,D,Nd,Np,Request,Proof}sk(P));

    recv_5(A,P,
      A,P,D,Nd,Np,Request,Proof,Decision,
      {D,A,P,Nd,Np,Request,Proof,Decision}sk(D),
      {A,P,D,Nd,Np,Request,Proof,Decision,
       {D,A,P,Nd,Np,Request,Proof,Decision}sk(D)}sk(A));

    claim(P,Secret,History);
    claim(P,Secret,StateRand);
    claim(P,Alive);
    claim(P,Weakagree);
    claim(P,Niagree);
    claim(P,Nisynch);

    send_6(P,A,
      P,A,D,Nd,Np,Request,Proof,Decision,
      {P,A,D,Nd,Np,Request,Proof,Decision}sk(P));
  }

  role A
  {
    var Nd,Np,Request: Nonce;
    var Proof: Ticket;
    fresh Decision: Nonce;

    recv_2(P,A,
      P,A,D,Nd,Np,Request,Proof,
      {D,P,A,Nd,Request}sk(D),
      {P,A,D,Nd,Np,Request,Proof}sk(P));

    send_3(A,D,
      A,D,P,Nd,Np,Request,Proof,Decision,
      {P,A,D,Nd,Np,Request,Proof}sk(P),
      {A,D,P,Nd,Np,Request,Proof,Decision}sk(A));

    recv_4(D,A,
      D,A,P,Nd,Np,Request,Proof,Decision,
      {D,A,P,Nd,Np,Request,Proof,Decision}sk(D));

    send_5(A,P,
      A,P,D,Nd,Np,Request,Proof,Decision,
      {D,A,P,Nd,Np,Request,Proof,Decision}sk(D),
      {A,P,D,Nd,Np,Request,Proof,Decision,
       {D,A,P,Nd,Np,Request,Proof,Decision}sk(D)}sk(A));

    recv_6(P,A,
      P,A,D,Nd,Np,Request,Proof,Decision,
      {P,A,D,Nd,Np,Request,Proof,Decision}sk(P));

    claim(A,Alive);
    claim(A,Weakagree);
    claim(A,Niagree);
    claim(A,Nisynch);
  }
}
